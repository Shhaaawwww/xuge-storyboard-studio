# Optional startup defaults. Settings saved from the UI take precedence.
# demo | openai-compatible
LLM_PROVIDER=demo

# OpenAI-compatible settings. Works with Ollama, vLLM and compatible gateways.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen3:8b

PORT=4317
WEB_PORT=5173

# Completed, failed, or interrupted job records are kept for 7 days by default.
# Running jobs never expire. Value is in milliseconds.
JOB_RETENTION_MS=604800000
